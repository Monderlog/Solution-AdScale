@startuml
top to bottom direction
skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowFontSize 10
skinparam rectangle {
  BackgroundColor #438DD5
  FontColor #FFFFFF
  BorderColor #3C7FC0
  RoundCorner 8
}
skinparam rectangle<<boundary>> {
  BackgroundColor #F8F8F8
  FontColor #333333
  BorderColor #666666
  BorderStyle solid
  RoundCorner 0
}
skinparam rectangle<<ext>> {
  BackgroundColor #B3B3B3
  FontColor #000000
  BorderColor #8F8F8F
}
skinparam database {
  BackgroundColor #08427B
  FontColor #FFFFFF
  BorderColor #073B6F
}
skinparam actor {
  BackgroundColor #08427B
  BorderColor #073B6F
}

title C4 Container Diagram: AdScale (AS-IS)\n15 000 RPS (пик), P95 110-120 мс при требовании ≤100 мс, деградации в часы пик

actor "Рекламодатель\nУправляет кампаниями,\nбюджетами и ставками" as advertiser
actor "Пользователь сайта/приложения\nПросматривает рекламу,\nкликает по баннерам" as endUser

rectangle "DSP-партнёр\nОтправляет bid-requests,\nполучает bid-responses по OpenRTB" as dspPartner <<ext>>
rectangle "Платёжный шлюз\nПополнение рекламных бюджетов" as paymentGateway <<ext>>

rectangle "AdScale Monolith (C++ / Go / Python / Node.js)" as monolith <<boundary>> {
  rectangle "Ad Server\n[C++, Go]\nПринимает HTTP-запросы, определяет\nпользователя, подбирает кандидатов" as adServer
  rectangle "Auction Engine\n[C++]\nВзвешивание ставок, бизнес-правила,\nрасчёт победителя" as auctionEngine
  rectangle "Delivery Service\n[Node.js]\nHTML/JS-разметка баннера\nи HTTP-ответ" as deliveryService
  rectangle "Statistics Service\n[Python]\nЗапись кликов и показов" as statsService
  rectangle "Financial Service\n[Go]\nСписания, счета, балансы" as financialService
  rectangle "Analytics Service\n[Python]\nАналитические SQL-запросы\nпо production-БД" as analyticsService
  rectangle "Advertiser Dashboard\n[Node.js + JavaScript]\nWeb UI: кампании, отчётность" as adCabinet
}

database "PostgreSQL\n(одна инстанция)\nЕдиная БД: кампании, ставки,\nсобытия, финансы, аналитика" as postgres

dspPartner --> adServer : Bid-requests / responses\nHTTPS / OpenRTB
endUser --> deliveryService : Просмотр рекламы и клики\nHTTPS
advertiser --> adCabinet : Кампании и бюджеты\nHTTPS
adCabinet --> paymentGateway : Пополнение бюджета\nHTTPS / REST

adServer --> auctionEngine : Кандидаты\nInternal Call
auctionEngine --> deliveryService : Победитель аукциона\nInternal Call
deliveryService --> statsService : Показы/клики\nInternal Call
adCabinet --> financialService : Финансы\nInternal Call
adCabinet --> analyticsService : Запросы аналитики\nInternal Call

auctionEngine --> postgres : Читает ставки и кампании\nJDBC / Sync
statsService --> postgres : Прямая запись событий\nJDBC / Direct Write
financialService --> postgres : Транзакции и балансы\nJDBC
analyticsService --> postgres : Тяжёлые аналитические запросы\nJDBC
adCabinet --> postgres : CRUD-операции\nJDBC
adServer --> postgres : Чтение таргетинга\nJDBC

note right of auctionEngine
  **⚠ Критический bottleneck**
  Синхронные вызовы к БД
  в hot path (SLA ≤ 100 мс)
end note

note right of postgres
  **⚠ Single Point of Failure**
  Одна инстанция, нет HA
  Нет read-replicas
  OLTP + аналитика конкурируют
end note

note bottom of statsService
  **⚠ write bottleneck**
  Прямая запись без буферизации / очередей
  Конкуренция за ресурсы БД
end note

note bottom of analyticsService
  **⚠ Блокировки и рост latency**
  Heavy queries напрямую на production-БД
end note

legend right
|= текущее состояние |= |
| Пик | 15 000 RPS |
| P95 | 110-120 мс при SLA ≤ 100 мс |
| Кеширование | отсутствует |
| Очереди | отсутствуют |
| Деплой | вручную, без контейнеризации |
endlegend

@enduml
